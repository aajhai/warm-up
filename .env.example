# GoLogin cloud auth. Token lives in the GoLogin app: Settings → API.
# Put it in .env. Do not paste tokens in chat.
GL_API_TOKEN=
GL_PROFILE_NAME=Kunal Mittal
GL_PROFILE_ID=

# cloud (recommended) connects directly to GoLogin Cloud Browser.
# Set local only when intentionally using the desktop app's loopback API.
GOLOGIN_BROWSER_MODE=cloud

# Safety
LIKES_ENABLED=true
STOP_PROFILE_AFTER_SESSION=true

# Slack incoming webhook; stored only in your local .env.
SLACK_WEBHOOK_URL=

# Enable My Network connection batches for production runs.
# --force and --test remain browse-only. --outside-hours allows production activity outside 9–5.
CONNECTIONS_ENABLED=false
